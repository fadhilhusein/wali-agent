# Copy this file to .env and fill in the values. .env is git-ignored. Never commit secrets.
# Real environment variables take precedence over values in .env.

# --- LLM (needed for live chat and the evaluation run; unit tests do not need it) ---
# Which kind of endpoint to talk to:
#   anthropic          the Anthropic SDK (default). Uses ANTHROPIC_API_KEY.
#   openai_compatible  any endpoint with an OpenAI-style /chat/completions. Uses WALI_LLM_API_KEY
#                      and needs WALI_LLM_BASE_URL.
WALI_LLM_PROVIDER=anthropic

# Key for the anthropic provider.
ANTHROPIC_API_KEY=
# Key for the openai_compatible provider.
WALI_LLM_API_KEY=

# Model ids. Model names are configuration, never hard-coded in the source.
# For openai_compatible, replace these with your provider's model names.
WALI_AGENT_MODEL=claude-opus-5-5
WALI_SENTINEL_MODEL=claude-haiku-5-5

# anthropic: leave empty for Anthropic's own endpoint.
# openai_compatible: required, the part before /chat/completions, e.g. https://api.example.com/v1
WALI_LLM_BASE_URL=
# Lower this if your provider's model has a smaller output limit (some allow only 4096 or 8192).
WALI_LLM_MAX_TOKENS=16000
# Only sent by the openai_compatible provider. 0 gives the most repeatable answers.
WALI_LLM_TEMPERATURE=
# low | medium | high | xhigh | max. Empty keeps the model's own default.
WALI_LLM_EFFORT=
# true | false. Empty means: on for Anthropic's own endpoint, off when WALI_LLM_BASE_URL is set.
# When on, a request declined by a safety classifier is re-run on another model by the API.
WALI_LLM_REFUSAL_FALLBACK=
WALI_LLM_TIMEOUT_SECONDS=120
# The effort and refusal-fallback settings above apply to the anthropic provider only.

# --- Guard signing key (Ed25519). Generate with: uv run python scripts/gen_guard_key.py --write-env ---
WALI_GUARD_PRIVATE_KEY=
WALI_GUARD_PUBLIC_KEY=

# --- Environment: sim (our simulated environment) or organiser (not implemented yet) ---
WALI_ENVIRONMENT=sim
# The date the simulation treats as today (YYYY-MM-DD). Empty means the day after the seed data ends.
WALI_SIM_TODAY=

# --- Storage (paths are relative to the directory you run from, normally the repo root) ---
WALI_DB_PATH=data/wali.db
WALI_GUARD_DB_PATH=data/guard.db
WALI_SEED_DIR=data/seed
WALI_AUDIT_LOG_PATH=data/audit.jsonl

# --- Locale ---
WALI_DEFAULT_CURRENCY=IDR
# Fixed UTC offset in hours (7 = Jakarta). A fixed offset avoids a tz database dependency.
WALI_UTC_OFFSET_HOURS=7

# --- Simulated environment failure injection (deterministic) ---
# Probability from 0 to 1 that a simulated tool call fails. 0 disables it.
SIM_FAIL_RATE=0
SIM_SEED=42

# --- Reconciliation tolerances ---
WALI_RECON_DATE_WINDOW_DAYS=3
WALI_RECON_AMOUNT_TOLERANCE=0
# Largest relative difference still treated as "same payment, different amount" (0.05 = 5%).
WALI_RECON_MISMATCH_MAX_RATIO=0.05

# --- Agent and guard ---
WALI_AGENT_MAX_STEPS=8
# User turns kept in a chat session before older ones are dropped.
WALI_HISTORY_MAX_TURNS=30
WALI_CONFIRM_TOKEN_TTL_SECONDS=300
WALI_PROPOSALS_PER_HOUR=10
# Sentinel (screening of outside text). It uses WALI_SENTINEL_MODEL for its model check; leave
# that empty to run on the built-in rules only.
# false: flagged text in a record makes payments for that invoice or supplier wait for the owner.
# true:  it also makes every payment in the same conversation turn wait for the owner.
WALI_SENTINEL_STRICT_TURN=false

# --- Evaluation ---
# PLACEHOLDER. Minutes a person needs to handle one reconciliation item by hand.
# To be replaced by the finance analyst with a figure from real interviews.
MANUAL_MINUTES_PER_ITEM=5
